# .gitignore

# ignore ruff cache
.cache/ruff

# ignore ruff log
.cache/ruff.log

# ignore ruff config
.ruffconfig

# ignore ruff cache for specific tool
.cache/ruff/flake8.cache

# ignore node_modules
node_modules/

# ignore IDE files
.idea/
.vscode/

# ignore other IDE files
*.iml
*.ipr
*.iws

# ignore other project files
*.pyc
*.pyo
*.egg-info
*.dist-info
__pycache__/

# ignore other IDE files
*.class
*.swp
*.swo